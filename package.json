{
  "name": "@coderrob/orderly",
  "version": "1.0.0",
  "description": "Agentic file and folder organization to maintain an orderly directory.",
  "main": "dist/index.js",
  "bin": {
    "orderly": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage && node scripts/make-coverage-badge.js",
    "test:ci": "jest --coverage --ci --maxWorkers=2 && node scripts/make-coverage-badge.js",
    "test:integration": "jest --config jest.integration.config.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "duplication": "jscpd src",
    "duplication:check": "jscpd src --ignore \"**/*.test.ts\" --threshold 1",
    "quality": "npm run lint && npm run format:check && npm run test:coverage",
    "verify": "npm run typecheck && npm run quality && npm run duplication:check",
    "prepack": "npm run verify && npm run build",
    "clean": "rimraf dist coverage reports .eslintcache"
  },
  "keywords": [
    "cli",
    "file-organization",
    "file-management",
    "naming-conventions"
  ],
  "author": "Robert Lindley",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.1",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@coderrob/eslint-plugin-zero-tolerance": "^1.1.8",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.5.0",
    "@vscode/ripgrep": "^1.17.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.8.1",
    "jest": "^30.3.0",
    "jscpd": "^4.0.8",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "sonarqube-scanner": "^4.3.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
